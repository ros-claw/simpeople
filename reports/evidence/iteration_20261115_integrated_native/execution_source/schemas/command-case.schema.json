{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosclaw.local/simpeople/command-case.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "split",
    "category",
    "polarity",
    "prompt",
    "fixture",
    "targets",
    "preserve",
    "budget",
    "predicates"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^c[0-9]{2}$"
    },
    "split": {
      "enum": [
        "development",
        "holdout"
      ]
    },
    "category": {
      "type": "string"
    },
    "polarity": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 10
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors"
      ],
      "properties": {
        "actors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actor_id",
              "asset_id",
              "position_m",
              "group",
              "role"
            ],
            "properties": {
              "actor_id": {
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "asset_id": {
                "const": "default"
              },
              "position_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "group": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "seated_actor": {
          "const": "a"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "enum": [
          "a",
          "b",
          "c",
          "d",
          "e"
        ]
      },
      "uniqueItems": true
    },
    "preserve": {
      "type": "array",
      "items": {
        "enum": [
          "a",
          "b",
          "c",
          "d",
          "e"
        ]
      },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_s",
        "sim_s",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "max_repairs"
      ],
      "properties": {
        "wall_s": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800
        },
        "sim_s": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 4000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "succeeded",
              "goal",
              "cancelled_then_wait",
              "negative",
              "unreachable",
              "batch",
              "fifo",
              "seat_clear",
              "failed_then_recovered"
            ]
          },
          "actor_id": {
            "enum": [
              "a",
              "b",
              "c",
              "d",
              "e"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target": {},
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_tool": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "items": {
              "enum": [
                "a",
                "b",
                "c",
                "d",
                "e"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "created_actors": {
      "type": "array",
      "items": {
        "enum": [
          "d",
          "e"
        ]
      },
      "uniqueItems": true
    }
  }
}
