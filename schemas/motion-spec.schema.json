{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosclaw.local/simpeople/motion-spec.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "rig_sha256",
    "context",
    "target"
  ],
  "properties": {
    "schema_version": {
      "const": "simpeople.motion-spec.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "rig_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sample_times_s",
        "local_poses"
      ],
      "properties": {
        "source": {
          "enum": [
            "authored_fixture",
            "executed_history"
          ]
        },
        "sample_times_s": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "local_poses": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_poses"
      ],
      "properties": {
        "local_poses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "episode_id",
        "actor_id",
        "actor_instance_id",
        "control_epoch",
        "task_id",
        "context_revision"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "control_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "context_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "context": {
            "properties": {
              "source": {
                "const": "executed_history"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "binding"
        ]
      }
    }
  ],
  "description": "Runtime additionally checks finite transforms, unit quaternions, the rig-specific joint count, consecutive 30 Hz times and context-revision digest."
}
