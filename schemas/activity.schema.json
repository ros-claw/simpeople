{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosclaw.local/simpeople/task.v1",
  "title": "SimPeople activity v1",
  "type": "object",
  "required": [
    "request_id",
    "actor_id",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "simpeople.task.v1"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "actor_id": {
      "$ref": "#/$defs/id"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "on_blocked": {
      "enum": [
        "report",
        "replan_or_report"
      ]
    },
    "on_cancel": {
      "const": "stop_activity"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "target": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "move_to",
            "wait",
            "look_at",
            "sit",
            "leave_seat",
            "follow",
            "custom_action",
            "queue"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 86400
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 86400
        },
        "gait": {
          "enum": [
            "walk",
            "run"
          ]
        },
        "speed_mps": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "tolerance_m": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "distance_m": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 20
        },
        "via": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "move_to",
                  "look_at",
                  "sit",
                  "follow",
                  "custom_action",
                  "queue"
                ]
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "wait",
                  "sit",
                  "follow",
                  "custom_action",
                  "queue"
                ]
              }
            }
          },
          "then": {
            "required": [
              "duration_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "custom_action"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    }
  }
}
